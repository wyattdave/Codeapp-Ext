{
  "name": "codeappjsext",
  "displayName": "CAP - Code Apps",
  "description": "VS Code wrapper for Power Apps Code App workflows using codeapp-js-cli",
  "version": "2.1.6",
  "icon": "cap-icon.png",
  "publisher": "PowerDevBox",
  "repository": "https://github.com/wyattdave/Codeapp-Ext",
  "engines": {
    "vscode": "^1.95.0"
  },
  "os": [
    "win32"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "power platform",
    "code apps",
    "dataverse",
    "codeapp-js-cli",
    "cap",
    "Power Apps"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "chatAgents": [
      {
        "path": "./node_modules/codeapp-js/AI/codeapp.agent.md",
        "sessionTypes": [
          "local"
        ]
      }
    ],
    "chatSkills": [
      {
        "path": "./node_modules/codeapp-js/AI/skills/autoreview/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/connections/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/dataverse/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/docs/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/environment-variables/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/frontend-design/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/jira/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/keyvault/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/logicflows/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/office365-groups/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/office365-outlook/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/office365-users/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/power-platform-admin-v2/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/security-review/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/sharepoint/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/sql/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/start/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      },
      {
        "path": "./node_modules/codeapp-js/AI/skills/teams/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      }
    ],
    "commands": [
      {
        "command": "codeappjsext.setup",
        "title": "CodeAppJS: Setup Project",
        "icon": "$(tools)"
      },
      {
        "command": "codeappjsext.import",
        "title": "CodeAppJS: Import Code App",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeappjsext.auth",
        "title": "CodeAppJS: Authenticate",
        "icon": "$(account)"
      },
      {
        "command": "codeappjsext.authChange",
        "title": "CodeAppJS: Change Authentication Account",
        "icon": "$(account)"
      },
      {
        "command": "codeappjsext.authLogout",
        "title": "CodeAppJS: Log Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "codeappjsext.environment",
        "title": "CodeAppJS: Change Environment",
        "icon": "$(globe)"
      },
      {
        "command": "codeappjsext.connections",
        "title": "CodeAppJS: Add Dataverse Schema",
        "icon": "$(plug)"
      },
      {
        "command": "codeappjsext.table",
        "title": "CodeAppJS: Add Dataverse Table",
        "icon": "$(table)"
      },
      {
        "command": "codeappjsext.environmentVariable",
        "title": "CodeAppJS: Add Environment Variable",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "codeappjsext.flowSchema",
        "title": "CodeAppJS: Add Flow Schema",
        "icon": "$(references)"
      },
      {
        "command": "codeappjsext.flowSchemaById",
        "title": "CodeAppJS: Add Flow Schema by ID",
        "icon": "$(references)"
      },
      {
        "command": "codeappjsext.skills",
        "title": "CodeAppJS: Skills",
        "icon": "$(book)"
      },
      {
        "command": "codeappjsext.mockup",
        "title": "CodeAppJS: Open Mockup",
        "icon": "$(device-desktop)"
      },
      {
        "command": "codeappjsext.debugger",
        "title": "CodeAppJS: Toggle Debugger",
        "icon": "$(debug-alt-small)"
      },
      {
        "command": "codeappjsext.deploy",
        "title": "CodeAppJS: Deploy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codeappjsext.toggleButtonVisibility",
        "title": "CodeAppJS: Toggle Button Visibility",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeappjsext.debugger",
          "when": "codeappjsext.buttonsVisible",
          "group": "navigation@1"
        },
        {
          "command": "codeappjsext.deploy",
          "when": "codeappjsext.buttonsVisible",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+alt+d",
        "command": "codeappjsext.deploy"
      }
    ]
  },
  "scripts": {
    "lint": "eslint src --ext js",
    "test": "node --test tests/*.test.js",
    "prevscode:prepublish": "npm install codeapp-js@latest --save-exact --prefer-online",
    "vscode:prepublish": "node scripts/sync-codeapp-assets.js",
    "package": "vsce package --target win32-x64",
    "package:win32-x64": "vsce package --target win32-x64"
  },
  "overrides": {
    "codeapp-js": "$codeapp-js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@azure/msal-node-extensions": "1.5.17",
    "@microsoft/power-apps-actions": "^1.10.1",
    "@microsoft/power-apps-common": "1.3.0",
    "codeapp-js": "2.2.1",
    "codeapp-js-cli": "^1.2.2",
    "open": "8.4.0"
  }
}
